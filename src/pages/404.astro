---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Página no encontrada | NovuChat"
  descripcion="Esta dirección no existe. Te dejamos por dónde seguir."
>
  <section class="seccion">
    <div class="contenedor" style="max-width: var(--ancho-lectura)">
      <h1>Esta página no existe</h1>
      <p style="font-size: 18px">
        Puede que el enlace esté viejo o que hayamos movido algo de lugar. No
        perdiste nada: acá está lo que la mayoría busca.
      </p>
      <div class="heroe-acciones">
        <a class="btn btn-cta btn-grande" href="/">Volver al inicio</a>
        <a class="btn btn-secondary btn-grande" href="/precios">Ver precios</a>
        <a class="btn btn-secondary btn-grande" href="/contacto">Escribirnos</a>
      </div>
    </div>
  </section>
</Base>
