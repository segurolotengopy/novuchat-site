---
import Base from '../layouts/Base.astro';
import { sitio } from '../contenido/sitio.es';

// Ver la nota de estado en /demo: el envío llega con la Function `lead`.
const formularioActivo = false;
---

<Base
  titulo="Contacto | NovuChat"
  descripcion="Escríbenos por WhatsApp o por correo. Estamos en La Paz, Bolivia, y respondemos el mismo día."
  rutaAlterna="/en/contacto"
  migajas={[
    { nombre: 'Inicio', ruta: '/' },
    { nombre: 'Contacto', ruta: '/contacto' },
  ]}
>
  <section class="seccion">
    <div class="contenedor heroe-rejilla">
      <div>
        <h1>Hablemos</h1>
        <p class="heroe-bajada">
          Si tienes una duda concreta, la vía más rápida es WhatsApp. Si prefieres
          escribir con calma, el correo llega al mismo lugar.
        </p>

        <div class="heroe-acciones">
          <a
            class="btn btn-cta btn-grande"
            href={`https://wa.me/${sitio.contacto.whatsappEnlace}`}
            rel="noopener"
          >
            WhatsApp {sitio.contacto.whatsapp}
          </a>
          <a class="btn btn-secondary btn-grande" href={`mailto:${sitio.contacto.correo}`}>
            {sitio.contacto.correo}
          </a>
        </div>

        <p class="texto-apagado" style="margin-top: var(--space-8)">
          {sitio.contacto.ciudad}, {sitio.contacto.pais}
        </p>
      </div>

      <form class="card elev-md" data-formulario-contacto>
        <h2 class="card-title">Envíanos un mensaje</h2>

        <div class="field">
          <label for="c-nombre">Tu nombre</label>
          <input class="input" id="c-nombre" name="nombre" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="c-correo">Correo</label>
          <input class="input" id="c-correo" name="correo" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="c-whatsapp">WhatsApp</label>
          <input class="input" id="c-whatsapp" name="whatsapp" type="tel" value="+591 " autocomplete="tel" />
        </div>

        <div class="field">
          <label for="c-mensaje">Mensaje</label>
          <textarea class="input" id="c-mensaje" name="mensaje" rows="5" required></textarea>
        </div>

        <div class="trampa" aria-hidden="true">
          <label for="c-empresa-web">No completar</label>
          <input id="c-empresa-web" name="empresa-web" tabindex="-1" autocomplete="off" />
        </div>

        <label class="radio" style="align-items: flex-start; gap: 10px">
          <input type="checkbox" name="privacidad" required style="position: static; width: auto; height: auto; opacity: 1" />
          <span style="font-size: 14px">
            He leído la <a href="/privacidad">política de privacidad</a>.
          </span>
        </label>

        <button class="btn btn-cta btn-block btn-grande" type="submit" disabled={!formularioActivo}>
          Enviar
        </button>

        {
          !formularioActivo && (
            <p class="field-pista" role="status">
              Estamos terminando de conectar este formulario. Mientras tanto,
              escríbenos por WhatsApp o al correo.
            </p>
          )
        }
      </form>
    </div>
  </section>
</Base>
