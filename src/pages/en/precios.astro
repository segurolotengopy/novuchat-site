---
import Base from '../../layouts/Base.astro';
import CaminosDelPlan from '../../components/CaminosDelPlan.astro';
import { pricing } from '../../contenido/precios.en';

const { planes, instalacion, bolsas, bolsasTexto, excepcional, quePagas, queNecesitamos, comoContamos } =
  pricing;
---

<Base
  titulo="NovuChat pricing"
  descripcion="Plans from USD 25 per month on your own WhatsApp Business account. AI included; WhatsApp messaging is paid directly to Meta. No long contracts."
  rutaAlterna="/precios"
>
  <section class="seccion">
    <div class="contenedor">
      <h1>Plans and pricing</h1>
      <p class="seccion-bajada" style="font-size: 18px">
        {pricing.bajada}
      </p>

      <div class="rejilla">
        {
          planes.map((plan) => (
            <article class={`plan${plan.destacado ? ' plan-destacado' : ''}`}>
              {plan.destacado && (
                <span class="tag tag-accent-2" style="align-self: flex-start">
                  Most chosen
                </span>
              )}
              <h2 class="plan-nombre">{plan.nombre}</h2>
              <p class="plan-precio">
                USD {plan.precioUsd} <small>/ month</small>
              </p>
              <p class="plan-instalacion">
                + USD {instalacion.estandar} one-time setup
              </p>
              <p class="plan-instalacion">{pricing.notaMeta}</p>
              <p class="card-body">{plan.resumen}</p>
              <p class="tag tag-neutral" style="align-self: flex-start">
                Up to {plan.conversaciones.toLocaleString('en-US')} conversations per month
              </p>
              <CaminosDelPlan
                caminos={plan.caminos}
                titulo="Choose your solution:"
                separador="or"
              />
              <ul class="plan-lista">
                {plan.incluye.map((c) => (
                  <li>
                    <span>
                      {c.texto}
                      {c.proximamente && (
                        <span class="tag tag-proximamente" style="margin-left: 6px">
                          Coming soon
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
              <a class="btn btn-primary btn-block" href="/demo">Request a demo</a>
            </article>
          ))
        }
      </div>

      <p class="texto-apagado" style="margin-top: var(--space-6); font-size: 14px">
        {pricing.pie} Setup is a one-time payment of USD {instalacion.estandar}, in
        advance and on top of the monthly fee. A conversation is up to 25 assistant
        replies to the same customer within 24 continuous hours; from reply 26
        another one is counted.
      </p>

      <p class="texto-apagado" style="margin-top: var(--space-3); font-size: 14px">
        Features marked "Coming soon" are not available yet. We list them so you
        know where the product is going, not to charge for them early.
      </p>
    </div>
  </section>

  <section class="seccion seccion-alterna">
    <div class="contenedor">
      <div class="rejilla" style="align-items: start">
        <article class="card elev-sm">
          <h2 class="card-title">{quePagas.titulo}</h2>
          <ul class="plan-lista">
            {
              quePagas.items.map((i) => (
                <li>
                  <span>
                    <strong>{i.aQuien}.</strong> {i.que}
                  </span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="card elev-sm">
          <h2 class="card-title">{queNecesitamos.titulo}</h2>
          <ul class="plan-lista">{queNecesitamos.items.map((i) => <li>{i}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla" style="align-items: start">
        <article class="card elev-sm">
          <h2 class="card-title">{bolsasTexto.titulo}</h2>
          <ul class="plan-lista">
            {bolsas.map((b) => <li>{b.conversaciones} conversations for USD {b.precioUsd}</li>)}
          </ul>
          <p class="card-body">{bolsasTexto.texto}</p>
        </article>

        <article class="card elev-sm">
          <h2 class="card-title">Setup</h2>
          <p class="plan-precio" style="font-size: 30px">
            USD {instalacion.estandar} <small>/ one-time payment</small>
          </p>
          <p class="card-body">
            Paid in advance, when the service starts.
          </p>
          <ul class="plan-lista">
            {instalacion.incluye.map((i) => <li>{i}</li>)}
          </ul>
          <p class="card-body">
            <strong>Custom, from USD {instalacion.aMedidaDesde}</strong>
          </p>
          <ul class="plan-lista">
            {instalacion.aMedidaEjemplos.map((e) => <li>{e}</li>)}
          </ul>
          <p class="card-body" style="font-size: 14px">
            {instalacion.aMedidaNota}
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="seccion seccion-alterna">
    <div class="contenedor">
      <h2 class="seccion-titulo">{comoContamos.titulo}</h2>
      <div style="max-width: var(--ancho-lectura)">
        {comoContamos.parrafos.map((p) => <p>{p}</p>)}
      </div>
      <table class="table" style="margin-top: var(--space-8); max-width: 780px">
        <thead>
          <tr><th scope="col">Term</th><th scope="col">What it means</th></tr>
        </thead>
        <tbody>
          {
            comoContamos.glosario.map((g) => (
              <tr>
                <th scope="row" style="text-transform: none; font-size: 15px; letter-spacing: 0">
                  {g.termino}
                </th>
                <td>{g.definicion}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="seccion" aria-label="Exceptional option">
    <div class="contenedor">
      <details class="acordeon" data-excepcional style="max-width: var(--ancho-lectura)">
        <summary>{excepcional.titulo}</summary>
        <div class="acordeon-cuerpo">
          <p>{excepcional.paraQuien}</p>
          <ul class="plan-lista">
            {
              planes.map((p) => (
                <li>
                  {p.nombre}: USD {p.precioUsd} per month, up to{' '}
                  {excepcional.conversaciones[p.id].toLocaleString('en-US')} conversations
                </li>
              ))
            }
          </ul>
          <ul class="plan-lista">{excepcional.diferencias.map((d) => <li>{d}</li>)}</ul>
          <p>
            Setup: USD {excepcional.instalacionUsd}, one-time payment in advance. Extra
            bundle: {excepcional.bolsa.conversaciones} conversations for USD{' '}
            {excepcional.bolsa.precioUsd}, never expires.
          </p>
          <p>
            {excepcional.nota} <a href="/en/contacto">Go to the contact page</a>.
          </p>
        </div>
      </details>
    </div>
  </section>
</Base>
