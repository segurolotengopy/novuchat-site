---
import Base from '../layouts/Base.astro';
import CaminosDelPlan from '../components/CaminosDelPlan.astro';
import { precios } from '../contenido/precios.es';

const { planes, instalacion, bolsas, bolsasTexto, excepcional, quePagas, queNecesitamos, comoContamos } =
  precios;
---

<Base
  titulo="Planes y precios de NovuChat"
  descripcion="Planes desde USD 25 al mes con tu propia cuenta de WhatsApp Business. La IA va incluida y la mensajería la pagas directamente a Meta. Sin contratos largos."
  rutaAlterna="/en/precios"
  migajas={[
    { nombre: 'Inicio', ruta: '/' },
    { nombre: 'Precios', ruta: '/precios' },
  ]}
>
  <section class="seccion">
    <div class="contenedor">
      <h1>Planes y precios</h1>
      <p class="seccion-bajada" style="font-size: 18px">
        {precios.bajada}
      </p>

      <div class="rejilla">
        {
          planes.map((plan) => (
            <article class={`plan${plan.destacado ? ' plan-destacado' : ''}`}>
              {plan.destacado && (
                <span class="tag tag-accent-2" style="align-self: flex-start">
                  El más elegido
                </span>
              )}
              <h2 class="plan-nombre">{plan.nombre}</h2>
              <p class="plan-precio">
                USD {plan.precioUsd} <small>/ mes</small>
              </p>
              <p class="plan-instalacion">
                + USD {instalacion.estandar} de instalación, pago único
              </p>
              <p class="plan-instalacion">{precios.notaMeta}</p>
              <p class="card-body">{plan.resumen}</p>
              <p class="tag tag-neutral" style="align-self: flex-start">
                Hasta {plan.conversaciones.toLocaleString('es-BO')} conversaciones al mes
              </p>
              <CaminosDelPlan
                caminos={plan.caminos}
                titulo="Elige tu solución:"
                separador="o bien"
              />
              <ul class="plan-lista">
                {plan.incluye.map((c) => (
                  <li>
                    <span>
                      {c.texto}
                      {c.proximamente && (
                        <span class="tag tag-proximamente" style="margin-left: 6px">
                          Próximamente
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
              <a class="btn btn-primary btn-block" href={`/demo?plan=${plan.id}`}>
                Empezar con {plan.nombre}
              </a>
            </article>
          ))
        }
      </div>

      <p class="texto-apagado" style="margin-top: var(--space-6); font-size: 14px">
        {precios.pie} La instalación es un pago único de USD {instalacion.estandar},
        por adelantado y aparte de la mensualidad. Una conversación son hasta 25
        respuestas del asistente a un mismo cliente en 24 horas continuas; a partir
        de la respuesta 26 en el mismo día se cuenta otra.
      </p>

      <p class="texto-apagado" style="margin-top: var(--space-3); font-size: 14px">
        Las funciones marcadas como «Próximamente» todavía no están disponibles.
        Las anunciamos aquí para que sepas hacia dónde va el producto, no para
        cobrarlas antes de tiempo.
      </p>
    </div>
  </section>

  <!-- ── Qué pagas y qué necesitamos ───────────────────────────────────── -->
  <section class="seccion seccion-alterna">
    <div class="contenedor">
      <div class="rejilla" style="align-items: start">
        <article class="card elev-sm">
          <h2 class="card-title">{quePagas.titulo}</h2>
          <ul class="plan-lista">
            {
              quePagas.items.map((i) => (
                <li>
                  <span>
                    <strong>{i.aQuien}.</strong> {i.que}
                  </span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="card elev-sm">
          <h2 class="card-title">{queNecesitamos.titulo}</h2>
          <ul class="plan-lista">{queNecesitamos.items.map((i) => <li>{i}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Bolsas e instalación ──────────────────────────────────────── -->
  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla" style="align-items: start">
        <article class="card elev-sm">
          <h2 class="card-title">{bolsasTexto.titulo}</h2>
          <ul class="plan-lista">
            {bolsas.map((b) => <li>{b.conversaciones} conversaciones por USD {b.precioUsd}</li>)}
          </ul>
          <p class="card-body">{bolsasTexto.texto}</p>
        </article>

        <article class="card elev-sm">
          <h2 class="card-title">Instalación</h2>
          <p class="plan-precio" style="font-size: 30px">
            USD {instalacion.estandar} <small>/ pago único</small>
          </p>
          <p class="card-body">
            Se paga por adelantado, al inicio del servicio.
          </p>
          <ul class="plan-lista">
            {instalacion.incluye.map((i) => <li>{i}</li>)}
          </ul>
          <p class="card-body">
            <strong>A medida, desde USD {instalacion.aMedidaDesde}</strong>
          </p>
          <ul class="plan-lista">
            {instalacion.aMedidaEjemplos.map((e) => <li>{e}</li>)}
          </ul>
          <p class="card-body" style="font-size: 14px">
            {instalacion.aMedidaNota}
          </p>
          {
            instalacion.bonificacion && (
              <p class="tag tag-accent-2" style="align-self: flex-start">
                {instalacion.bonificacion}
              </p>
            )
          }
        </article>
      </div>
    </div>
  </section>

  <!-- ── Cómo contamos ─────────────────────────────────────────────────── -->
  <section class="seccion seccion-alterna" id="como-contamos">
    <div class="contenedor">
      <h2 class="seccion-titulo">{comoContamos.titulo}</h2>
      <div style="max-width: var(--ancho-lectura)">
        {comoContamos.parrafos.map((p) => <p>{p}</p>)}
      </div>

      <table class="table" style="margin-top: var(--space-8); max-width: 780px">
        <caption class="solo-lectores">Glosario de las unidades que se miden</caption>
        <thead>
          <tr>
            <th scope="col">Término</th>
            <th scope="col">Qué significa</th>
          </tr>
        </thead>
        <tbody>
          {
            comoContamos.glosario.map((g) => (
              <tr>
                <th scope="row" style="text-transform: none; font-size: 15px; letter-spacing: 0">
                  {g.termino}
                </th>
                <td>{g.definicion}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Opción excepcional (colapsada: no se publicita) ───────────────── -->
  <section class="seccion" aria-label="Opción excepcional">
    <div class="contenedor">
      <details class="acordeon" data-excepcional style="max-width: var(--ancho-lectura)">
        <summary>{excepcional.titulo}</summary>
        <div class="acordeon-cuerpo">
          <p>{excepcional.paraQuien}</p>
          <ul class="plan-lista">
            {
              planes.map((p) => (
                <li>
                  {p.nombre}: USD {p.precioUsd} al mes, hasta{' '}
                  {excepcional.conversaciones[p.id].toLocaleString('es-BO')} conversaciones
                </li>
              ))
            }
          </ul>
          <ul class="plan-lista">{excepcional.diferencias.map((d) => <li>{d}</li>)}</ul>
          <p>
            Instalación: USD {excepcional.instalacionUsd}, pago único por adelantado.
            Bolsa adicional: {excepcional.bolsa.conversaciones} conversaciones por USD{' '}
            {excepcional.bolsa.precioUsd}, no vence.
          </p>
          <p>
            {excepcional.nota} <a href="/contacto">Ir a la página de contacto</a>.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="seccion banda">
    <div class="contenedor" style="text-align: center">
      <h2 class="seccion-titulo" style="margin-inline: auto">
        ¿No sabes qué plan te conviene?
      </h2>
      <p class="seccion-bajada" style="margin-inline: auto">
        Cuéntanos cuántos clientes atiendes al día y te decimos cuál alcanza. Sin
        vender de más.
      </p>
      <a class="btn btn-cta btn-grande" href="/demo">Pedir una demostración</a>
    </div>
  </section>
</Base>
