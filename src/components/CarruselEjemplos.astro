---
import type { EjemploDeUso } from '../contenido/tipos';

interface Props {
  ejemplos: EjemploDeUso[];
}

const { ejemplos } = Astro.props;

/**
 * Carrusel de ejemplos de aplicación y uso, como en el prototipo: foto a un
 * lado, frase al otro, flechas y puntos de posición.
 *
 * Decisiones de construcción:
 *
 *  · El desplazamiento es **`scroll-snap` nativo**, no `translateX` calculado
 *    con JavaScript. Así el carrusel se arrastra con el dedo desde el primer
 *    momento y **sigue funcionando aunque el JavaScript no cargue**: sin él
 *    queda un carrusel deslizable, no un bloque roto.
 *  · **No hay reproducción automática.** Un carrusel que avanza solo mueve el
 *    contenido bajo la mano de quien está leyendo (WCAG 2.2.2).
 *  · Cada diapositiva es un `div` con `role="group"`, no un `article`:
 *    sobrescribir el rol implícito de `article` deja el árbol de accesibilidad
 *    mal formado, y Lighthouse lo marca.
 *  · Las frases **no son testimonios**: nadie las dijo. Son ejemplos redactados
 *    y así se rotulan, sin nombre ni ciudad (decisión de Andres, 2026-09-02).
 */
---

<div
  class="carrusel"
  data-carrusel
  role="group"
  aria-roledescription="carrusel"
  aria-label="Ejemplos de aplicación y uso por rubro"
>
  {/*
    `tabindex="0"` en un contenedor con desplazamiento **es correcto**: si no se
    puede enfocar, quien navega con teclado no puede desplazarlo (WCAG 2.1.1).
    La regla de ESLint solo contempla elementos interactivos y aquí se desactiva
    a conciencia, con `role` y etiqueta para que se anuncie como corresponde.
  */}
  {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
  <div
    class="carrusel-pista"
    data-carrusel-pista
    tabindex="0"
    role="region"
    aria-label="Ejemplos, deslizable con las flechas del teclado"
  >
  {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    {
      ejemplos.map((e, i) => (
        <div
          class="carrusel-diapositiva"
          data-carrusel-diapositiva
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${ejemplos.length}: ${e.rubro}`}
        >
          <img
            src={e.foto.archivo}
            alt={e.foto.alt}
            width="900"
            height="672"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="carrusel-texto">
            <span class="tag tag-accent-2" style="align-self: flex-start">
              {e.rubro}
            </span>
            <p class="carrusel-frase">{e.frase}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="carrusel-controles">
    <div class="carrusel-puntos" data-carrusel-puntos>
      {
        ejemplos.map((e, i) => (
          <button
            type="button"
            class="carrusel-punto"
            data-carrusel-ir={i}
            aria-label={`Ver el ejemplo ${i + 1}: ${e.rubro}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span />
          </button>
        ))
      }
    </div>

    <div class="carrusel-flechas">
      <button
        type="button"
        class="btn btn-secondary btn-icon"
        data-carrusel-anterior
        aria-label="Ejemplo anterior"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
          stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        class="btn btn-secondary btn-icon"
        data-carrusel-siguiente
        aria-label="Ejemplo siguiente"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
          stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .carrusel {
    display: grid;
    gap: var(--space-4);
  }

  .carrusel-pista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    border-radius: calc(var(--radius-lg) * 1.15);
    box-shadow: var(--shadow-lg);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carrusel-pista::-webkit-scrollbar {
    display: none;
  }

  .carrusel-diapositiva {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-surface);
    scroll-snap-align: start;
  }

  @media (width >= 700px) {
    .carrusel-diapositiva {
      grid-template-columns: 1fr 1fr;
    }
  }

  .carrusel-diapositiva img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* Mismo tratamiento del prototipo: la foto baja de saturación para que la
       frase, y no la imagen de archivo, sea lo que se lee primero. */
    filter: saturate(0.72) contrast(0.92);
  }

  .carrusel-texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
    padding: var(--space-8) var(--space-6);
  }

  .carrusel-frase {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(19px, 2.4vw, 26px);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.015em;
    line-height: 1.18;
    text-wrap: pretty;
  }

  .carrusel-controles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .carrusel-puntos {
    display: flex;
    gap: var(--space-2);
  }

  /* El punto es pequeño, pero su zona de toque mide 44 px. */
  .carrusel-punto {
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    place-items: center;
  }

  .carrusel-punto span {
    display: block;
    width: 30px;
    height: 5px;
    border-radius: var(--radius-pildora);
    background: var(--color-accent-200);
    transition: background-color 200ms ease;
  }

  .carrusel-punto[aria-current="true"] span {
    background: var(--color-accent-2);
  }

  .carrusel-flechas {
    display: flex;
    gap: var(--space-2);
  }
</style>

<script>
  /**
   * El carrusel ya desliza sin JavaScript. Esto solo agrega las flechas, los
   * puntos y el seguimiento de la posición.
   */
  const carrusel = document.querySelector<HTMLElement>('[data-carrusel]');
  const pista = carrusel?.querySelector<HTMLElement>('[data-carrusel-pista]');

  if (carrusel && pista) {
    const diapositivas = Array.from(
      pista.querySelectorAll<HTMLElement>('[data-carrusel-diapositiva]'),
    );
    const puntos = Array.from(
      carrusel.querySelectorAll<HTMLButtonElement>('[data-carrusel-ir]'),
    );

    const suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // La posición se lleva en una variable y NO se deduce de `scrollLeft` en
    // cada clic: mientras una animación suave está en vuelo, `scrollLeft`
    // devuelve un punto intermedio y las flechas saltarían de diapositiva
    // equivocada. El desplazamiento con el dedo la reconcilia más abajo.
    let indice = 0;

    const irA = (destino: number) => {
      const total = diapositivas.length;
      if (total === 0) return;

      const siguiente = ((destino % total) + total) % total;

      // Cada diapositiva ocupa exactamente el ancho de la pista
      // (`grid-auto-columns: 100%`), así que el destino es una multiplicación,
      // no una medición. Medir con `getBoundingClientRect` mientras una
      // animación está en vuelo daba posiciones a medio camino.
      const objetivo = siguiente * pista.clientWidth;

      indice = siguiente;
      marcarPunto(indice);
      pista.scrollTo({ left: objetivo, behavior: suave ? 'smooth' : 'auto' });

      // Salvaguarda: hay contextos donde el navegador descarta la animación
      // suave y el carrusel se queda quieto —una flecha que no hace nada es
      // peor que una sin animación—. Si a los 350 ms no se movió, se salta.
      window.setTimeout(() => {
        if (Math.abs(pista.scrollLeft - objetivo) > 4) {
          pista.scrollTo({ left: objetivo });
        }
      }, 350);
    };

    const marcarPunto = (indice: number) => {
      puntos.forEach((punto, i) => {
        if (i === indice) punto.setAttribute('aria-current', 'true');
        else punto.removeAttribute('aria-current');
      });
    };

    carrusel
      .querySelector('[data-carrusel-anterior]')
      ?.addEventListener('click', () => irA(indice - 1));

    carrusel
      .querySelector('[data-carrusel-siguiente]')
      ?.addEventListener('click', () => irA(indice + 1));

    puntos.forEach((punto) => {
      punto.addEventListener('click', () => {
        irA(Number(punto.dataset['carruselIr']));
      });
    });

    // La posición también se lee del propio desplazamiento, para que el
    // indicador acierte cuando el carrusel se arrastra con el dedo.
    //
    // Se usa `setTimeout` y no `requestAnimationFrame`: hay contextos donde el
    // navegador no produce fotogramas (una pestaña en segundo plano, una vista
    // sin composición) y el rAF no llega nunca, dejando el punto activo
    // congelado en el primero. El temporizador sí llega siempre.
    let pendiente: number | undefined;
    pista.addEventListener('scroll', () => {
      window.clearTimeout(pendiente);
      pendiente = window.setTimeout(() => {
        const ancho = pista.clientWidth || 1;
        const aproximado = pista.scrollLeft / ancho;
        const cercano = Math.round(aproximado);
        // Solo se reconcilia cuando el desplazamiento quedó **sobre** una
        // diapositiva. A mitad de una animación la posición no significa nada,
        // y actualizar el punto ahí lo hacía parpadear a la diapositiva
        // equivocada.
        if (Math.abs(aproximado - cercano) < 0.02) {
          indice = cercano;
          marcarPunto(indice);
        }
      }, 150);
    });
  }
</script>
