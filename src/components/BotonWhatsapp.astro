---
import { sitio } from '../contenido/sitio.es';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const texto =
  idioma === 'en' ? 'Chat with our virtual assistant' : 'Chatea con nuestro asistente virtual';
const mensaje =
  idioma === 'en' ? 'Hello, I would like to know about NovuChat.' : 'Hola, quiero conocer NovuChat.';
const enlace = `https://wa.me/${sitio.contacto.whatsappAsistenteEnlace}?text=${encodeURIComponent(mensaje)}`;
---

<a class="whatsapp-boton" href={enlace} rel="noopener" aria-label={`${texto} (WhatsApp)`}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.200Zm4.500-6.100c-.2-.1-1.500-.7-1.700-.8-.2-.1-.4-.1-.6.100-.2.200-.6.800-.8 1-.1.200-.3.200-.5.100a6.700 6.700 0 0 1-3.300-2.900c-.3-.4.300-.4.800-1.400.1-.200 0-.300 0-.500l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.100-.7.300-.2.300-.9.900-.9 2.200s.9 2.500 1 2.700c.1.200 1.800 2.800 4.400 3.900 1.600.7 2.200.7 3 .6.5-.1 1.500-.6 1.700-1.200.2-.6.200-1.100.1-1.200-.1-.1-.2-.2-.5-.3Z"
    ></path>
  </svg>
  <span>{texto}</span>
</a>
