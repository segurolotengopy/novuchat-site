---
import { sitio } from '../contenido/sitio.es';
import { urlConsola } from '../lib/consola';

interface Props {
  /** Ruta actual, para marcar el enlace con `aria-current`. */
  ruta: string;
}

const { ruta } = Astro.props;

// El aviso se retira solo en la fecha indicada en el contenido, sin que nadie
// tenga que acordarse de desplegar ese día.
const aviso = sitio.aviso;
const mostrarAviso = aviso !== null && new Date() < new Date(aviso.hasta);
---

{
  mostrarAviso && aviso && (
    <div class="aviso">
      <div class="contenedor">{aviso.texto}</div>
    </div>
  )
}

<header class="cabecera">
  <div class="contenedor nav">
    <a class="nav-brand" href="/" aria-label={`${sitio.nombre}, ir al inicio`}>
      <img src="/isotipo.svg" alt="" width="30" height="30" />
      {sitio.nombre}
    </a>

    <nav class="nav-enlaces" aria-label="Principal">
      {
        sitio.navegacion.map((enlace) => (
          <a
            href={enlace.ruta}
            aria-current={ruta.startsWith(enlace.ruta) ? 'page' : undefined}
          >
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <div class="nav-acciones">
      <button
        type="button"
        class="btn btn-icon btn-secondary"
        data-tema-boton
        aria-label="Cambiar entre tema claro y oscuro"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
          stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
      </button>

      <a class="btn btn-secondary" href={urlConsola} rel="noopener">Ingresar</a>
      <a class="btn btn-cta" href="/demo">Pedir una demo</a>
    </div>
  </div>
</header>

<style>
  .nav-enlaces {
    display: none;
    gap: var(--space-6);
  }

  .nav-acciones {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  /* En móvil se esconden los enlaces secundarios: quedan el logotipo, el tema y
     las dos acciones. La navegación completa vive en el pie, que en un sitio
     de una docena de páginas es suficiente y ahorra un menú desplegable con su
     trampa de foco. */
  @media (width >= 900px) {
    .nav-enlaces {
      display: flex;
    }
  }

  @media (width <= 480px) {
    .nav-acciones .btn-secondary:not(.btn-icon) {
      display: none;
    }
  }
</style>
