# Valores de los secretos PARA EL EMULADOR. Copie este archivo a
# `functions/.secret.local`, que está ignorado por git.
#
# Son valores de mentira a propósito: en el emulador no se sale a internet
# (`lead.ts` omite el aviso por correo cuando FUNCTIONS_EMULATOR es "true"),
# así que ningún valor real hace falta para probar.
FORMSUBMIT_ALIAS=aliasdepruebalocal
SAL_HASH=sal-de-prueba-solo-para-el-emulador
