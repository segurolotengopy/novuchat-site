# Copie este archivo a `.env` y complete los valores.
# `.env` está en .gitignore: NUNCA se versiona. Este repositorio es público.
# Los valores PUBLIC_* se incrustan en el paquete del navegador: son identificadores
# públicos por diseño, no secretos. Los secretos reales (GEMINI_API_KEY, RESEND_API_KEY)
# viven únicamente en Secret Manager y nunca en este archivo.

# Destino del botón "Ingresar". Validado en build contra la lista blanca
# (consola.novuchat.site | novuchat-admin-prod.web.app). Ver docs/04 §2, riesgo S-13.
PUBLIC_URL_CONSOLA=

# Clave de sitio de reCAPTCHA Enterprise usada por App Check (pública).
PUBLIC_RECAPTCHA_SITE_KEY=

# Configuración del SDK web de Firebase (proyecto novuchat-site).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Región de las Cloud Functions (debe coincidir con connect-src de la CSP).
PUBLIC_REGION_FUNCTIONS=

# Medición. Identificadores públicos: se incrustan en la página y solo se
# activan tras el consentimiento del visitante (ver docs/csp.md).
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_MEASUREMENT_ID=
