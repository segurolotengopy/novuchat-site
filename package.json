{
  "name": "novuchat-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio comercial de NovuChat: asistentes conversacionales de WhatsApp con IA para negocios de Bolivia.",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sellar-csp.mjs",
    "preview": "astro preview",
    "emuladores": "firebase emulators:start --only functions,firestore --project novuchat-site",
    "pruebas": "vitest run --passWithNoTests --exclude \"pruebas/humo/**\" --exclude \"pruebas/reglas/**\" --exclude \"pruebas/backend/**\" --exclude \"node_modules/**\"",
    "humo": "playwright test",
    "csp": "node scripts/probar-csp.mjs",
    "prohibiciones": "node scripts/verificar-prohibiciones.mjs",
    "verificar": "pnpm lint && pnpm typecheck && pnpm funciones:build && pnpm pruebas && pnpm prohibiciones && pnpm build && pnpm csp:verificar && pnpm humo",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input",
    "typecheck": "astro check --minimumSeverity error",
    "test": "vitest run --passWithNoTests --exclude \"pruebas/humo/**\" --exclude \"pruebas/reglas/**\" --exclude \"pruebas/backend/**\" --exclude \"node_modules/**\"",
    "test:rules": "./scripts/pruebas-emulador.sh pruebas/reglas",
    "rag:indexar": "tsx scripts/indexar-conocimiento.ts",
    "listo": "node scripts/verificar-listo.mjs",
    "rag:verificar": "tsx scripts/indexar-conocimiento.ts --verificar",
    "funciones:build": "pnpm --dir functions run build",
    "csp:verificar": "node scripts/sellar-csp.mjs --verificar",
    "rag:calibrar": "tsx scripts/calibrar-umbral.ts",
    "test:backend": "./scripts/pruebas-emulador.sh pruebas/backend",
    "test:rules:local": "firebase emulators:exec --only firestore --project novuchat-site-reglas \"./scripts/pruebas-emulador.sh pruebas/reglas\"",
    "test:backend:local": "firebase emulators:exec --only functions,firestore --project novuchat-site \"./scripts/pruebas-emulador.sh pruebas/backend\"",
    "asistente:probar": "tsx scripts/probar-asistente.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "firebase": "^12.18.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
